# QuotaFlow Environment Variables Example

# Node Environment
NODE_ENV=development

# Database (PostgreSQL)
# For local run without docker: host is localhost:5434 (mapped from docker)
# For docker compose internal services: host is postgres:5432
POSTGRES_PORT=5434
DATABASE_URL=postgresql://quotaflow_user:quotaflow_secret@localhost:5434/quotaflow_db?schema=public

# API Service
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Frontend Web Application
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Internal API URL for Next.js SSR when inside Docker
INTERNAL_API_URL=http://api:4000

# Administrative / Bootstrap Configuration
ADMIN_API_KEY=qf_admin_dev_bootstrap_secret_key_2026

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Webhook Worker
WEBHOOK_WORKER_INTERVAL_MS=3000
WEBHOOK_MAX_RETRIES=3

# Logging
LOG_LEVEL=info
